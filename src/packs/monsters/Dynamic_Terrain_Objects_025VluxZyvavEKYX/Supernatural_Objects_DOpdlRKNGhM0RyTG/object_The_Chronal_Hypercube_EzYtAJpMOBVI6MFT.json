      "type": "feature",
      "_id": "e5NoyuvP5Bz1ifF5",
      "img": "icons/commodities/tech/console-steel.webp",
      "system": {
        "description": {
          "value": "<p>A creature who has the Psionics skill can deactivate and take control of the chronal hypercube by making a [[/test R]] while within 10 squares of the hypercube.</p><dl class=\"power-roll-display\"><dt class=\"tier1\"><p>!</p></dt><dd><p>The creature takes [[/damage 1d6 psychic]] damage.</p></dd><dt class=\"tier2\"><p>@</p></dt><dd><p>The creature fails to deactivate the hypercube.</p></dd><dt class=\"tier3\"><p>#</p></dt><dd><p>The hypercube teleports adjacent to the creature at the start of the next round and becomes an ally to the creature and their allies.</p></dd></dl>",
          "director": ""
        },
