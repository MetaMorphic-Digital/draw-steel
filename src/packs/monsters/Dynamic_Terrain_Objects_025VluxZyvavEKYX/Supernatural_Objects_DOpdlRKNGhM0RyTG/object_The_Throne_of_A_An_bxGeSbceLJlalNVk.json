  "items": [
    {
      "name": "Deactivate",
      "type": "feature",
      "_id": "IH5FLoADa8goJep5",
      "img": "icons/commodities/tech/console-steel.webp",
      "system": {
        "description": {
          "value": "<p>The throne of A’An can be deactivated only by the current hierophant of A’An (see <strong>Sitting on the Throne</strong>), who must succeed on a [[/test P]] that takes a bane to do so.</p><dl class=\"power-roll-display\"><dt class=\"tier1\"><p>!</p></dt><dd><p>The hierophant triggers the <strong>Nova</strong> ability.</p></dd><dt class=\"tier2\"><p>@</p></dt><dd><p>The hierophant fails to deactivate the throne.</p></dd><dt class=\"tier3\"><p>#</p></dt><dd><p>The throne is deactivated until the end of the encounter.</p></dd></dl>",
          "director": ""
        },
        "source": {
