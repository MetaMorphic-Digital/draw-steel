{
  "folder": "z0NsGGv2oolZgZbx",
  "name": "Vuken Growing Ferocity",
  "type": "feature",
  "_id": "ZHBBIajGPvdipqSR",
  "img": "icons/creatures/abilities/bear-roar-bite-brown-green.webp",
  "system": {
    "description": {
      "value": "<p>As your ferocity grows, you gain benefits as noted on the Vuken Growing Ferocity table. Benefits are cumulative except where an improved benefit replaces a lesser benefit.</p><table><thead><tr><th><p>Ferocity</p></th><th><p>Benefit</p></th></tr></thead><tbody><tr><td><p>2</p></td><td><p>Whenever you use the Knockback maneuver, you can target one additional creature.</p></td></tr><tr><td><p>4</p></td><td><p>The first time on a turn that you push a creature or knock a creature prone, you [[/surge 1]].</p></td></tr><tr><td><p>6</p></td><td><p>You gain an edge on Agility tests and the Knockback maneuver.</p></td></tr><tr><td><p>8 (4th level)</p></td><td><p>The first time on a turn that you push a creature or knock a creature prone, you [[/surge 2]].</p></td></tr><tr><td><p>10 (7th level)</p></td><td><p>You have a double edge on Agility tests and the Knockback maneuver.</p></td></tr><tr><td><p>12 (10th level)</p></td><td><p>Whenever you use a heroic ability, you gain [[/heal 10 temp]]. Additionally, whenever you make a power roll that imposes forced movement on a target, the forced movement distance gains a bonus equal to [[lookup @A]]{your Agility score}.</p></td></tr></tbody></table>",
      "director": ""
    },
    "source": {
