<header class="effect-config">
  <select data-name="system.end.type">
    {{selectOptions dsEffectEnds.options selected=dsEffectEnds.selected blank=(localize "COMMON.Default")}}
  </select>
</header>
<section class="effect-pane">
  {{#each statusEffects as |status|}}
  <div class="effect-group {{status.cssClass}} flexrow" {{#if status.disabled}}disabled{{else}}data-action="effect"{{/if}} data-status-id="{{status.id}}" data-tooltip="{{status.tooltip}}" data-effect-ids="{{status.effectIds}}">
    <span class="title ellipsis">{{status.title}}</span>
    <img class="effect-control" src="{{status.src}}" alt="{{status.title}}">
  </div>
  {{/each}}
</section>
