{{! Stats Tab }}
<section class="tab stats standard-form {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <div class="form-group">
    <fieldset class="resources flexrow">
      <legend>{{localize "DRAW_STEEL.SHEET.Resources"}}</legend>
      {{#if isPlay}}
      <div class="resource stamina flexcol">
        <label class="resource-label">
          {{systemFields.stamina.label}}
        </label>
        <div class="form-group resource-content">
          <div class="resource-temporary">
            {{formGroup
            systemFields.stamina.fields.temporary
            value=system.stamina.temporary
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <div class="resource-current">
            {{formGroup
            systemFields.stamina.fields.value
            value=system.stamina.value
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <span class="resource-max">
            <div class="form-group stacked">
              <label class="input-placeholder-label">
                {{systemFields.stamina.fields.max.label}}
              </label>
              <div class="input-placeholder">
                {{system.stamina.max}}
              </div>
            </div>
          </span>
        </div>
      </div>
      <div class="resource recoveries flexcol">
        <div class="resource-label">
          {{#if editable}}
          <button
            type="button"
            data-action="spendRecovery"
            data-tooltip="DRAW_STEEL.Actor.base.SpendRecovery.tooltip"
            data-tooltip-direction="UP"
          >
            <i class="fa-solid fa-heart-pulse" inert></i>
            {{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.label"}}
          </button>
          {{else}}
          <span>{{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.label"}}</span>
          {{/if}}
        </div>
        <div class="form-group resource-content">
          <div class="resource-current">
            {{formGroup recoveryFields.value value=recoveries.value dataset=datasets.notSource classes="stacked" disabled=true}}
          </div>
          <span class="resource-max">
            <div class="form-group stacked">
              <label class="input-placeholder-label">
                {{recoveryFields.max.label}}
              </label>
              <div class="input-placeholder">
                {{recoveries.max}}
              </div>
            </div>
          </span>
          <span class="recovery-value">
            <div class="form-group stacked">
              <label class="input-placeholder-label">
                {{localize "DRAW_STEEL.Actor.base.FIELDS.stamina.label"}}
              </label>
              <div class="input-placeholder">
                {{recoveries.recoveryValue}}
              </div>
            </div>
          </span>
        </div>
      </div>
      <div class="resource heroic flexcol">
        {{#if owner}}
        <button type="button" data-action="freeStrike">
          {{systemFields.companion.fields.freeStrike.label}}
          <i class="fa-solid fa-burst" inert></i>
          {{system.freeStrike.value}}
        </button>
        {{else}}
        <div class="form-group slim">
          <label>{{systemFields.companion.fields.freeStrike.label}}</label>
          <div class="form-fields">
            <input type="number" disabled value="{{system.freeStrike.value}}">
          </div>
        </div>
        {{/if}}
        {{formGroup heroFields.primary.fields.value value=system.companion.master.system.hero.primary.value dataset=datasets.notSource label=system.companion.master.system.hero.primary.label classes="slim" disabled=true}}
        {{formGroup heroFields.surges value=system.companion.master.system.hero.surges dataset=datasets.notSource classes="slim" disabled=true}}
        {{#if (gte system.level 10)}}
        {{formGroup heroFields.epic.fields.value value=system.companion.master.system.hero.epic.value dataset=datasets.notSource label=system.hero.epic.label classes="slim" disabled=true}}
        {{/if}}
      </div>
      {{else}}
      {{formGroup systemFields.companion.fields.freeStrike value=systemSource.companion.freeStrike dataset=datasets.isSource}}
      {{/if}}
    </fieldset>
  </div>
  {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/characteristics.hbs"  editCharacteristics=false}}
  {{#if isPlay}}
  <div class="form-group">
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
  </div>
  {{else}}
  {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
  {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
  {{/if}}
  {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/immunities-weaknesses.hbs"}}
  <fieldset class="skills">
    <legend>{{systemFields.companion.fields.skills.label}}</legend>
    {{system.skills.list}}
  </fieldset>
</section>
