<section class="metadata">
  {{#if system.resource}}
  <p class="resource">
    {{localize "DRAW_STEEL.Item.ability.ResourceCost" value=system.resource name=resourceName}}
  </p>
  {{/if}}
  {{#if system.story}}
  <p class="flavor">
    <em>{{system.story}}</em>
  </p>
  {{/if}}
  <dl>
    <dt class="keywords">{{systemFields.keywords.label}}</dt>
    <dd class="keywords">{{keywordList}}</dd>

    <dt class="type">{{systemFields.type.label}}</dt>
    <dd class="type">{{actionTypeLabel}}</dd>

    <dt class="distance" data-tooltip-text="{{systemFields.distance.label}}">o</dt>
    <dd class="distance">{{distanceLabel}}</dd>

    <dt class="target" data-tooltip-text="{{systemFields.target.label}}">x</dt>
    <dd class="target">{{targetLabel}}</dd>

    {{#if triggeredAction}}
    <dt class="trigger">{{systemFields.trigger.label}}</dt>
    <dd class="trigger">{{system.trigger}}</dd>
    {{/if}}
  </dl>
</section>
<section class="effect before">
  {{#each beforeEffects}}
  <dl>
    <dt class="effect">{{label}}</dt>
    <dd class="effect">{{{text}}}</dd>
  </dl>
  {{/each}}
</section>
{{#if powerRolls}}
<section class="powerResult">
  {{#unless system.power.roll.reactive}}
  <p>
    <strong>{{{localize "DRAW_STEEL.ROLL.Power.RollPlusBonus" bonus=powerRollBonus}}}</strong>
  </p>
  {{/unless}}
  <dl class="power-roll-display">
    <dt class="tier1">!</dt>
    <dd class="tier1">{{{powerRollEffects.tier1}}}</dd>

    <dt class="tier2">@</dt>
    <dd class="tier2">{{{powerRollEffects.tier2}}}</dd>

    <dt class="tier3">#</dt>
    <dd class="tier3">{{{powerRollEffects.tier3}}}</dd>

  </dl>
</section>
{{/if}}
<section class="effect after">
  {{#each afterEffects}}
  <dl>
    <dt class="effect">{{label}}</dt>
    <dd class="effect">{{{text}}}</dd>
  </dl>
  {{/each}}
</section>
