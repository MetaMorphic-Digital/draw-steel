<section class="standard-form">
  {{#if ability.system.power.roll.enabled}}
  <div class="roll-config">
    <div class="global group">
      <div class="header">{{formula}}</div>
      <div class="form-group general">
        <label class="edges-banes">
          <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Edges"}}</span>
          <select name="modifiers.edges" data-dtype="Number">
            {{selectOptions modChoices selected=modifiers.edges}}
          </select>
        </label>
        <label class="edges-banes">
          <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Banes"}}</span>
          <select name="modifiers.banes" data-dtype="Number">
            {{selectOptions modChoices selected=modifiers.banes}}
          </select>
        </label>
        <label>
          <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Bonuses"}}</span>
          {{numberInput modifiers.bonuses name="modifiers.bonuses" step=1}}
        </label>
      </div>
    </div>
    {{#each targets as |target|}}
    <div class="target group" data-token-uuid="{{target.token.uuid}}">
      <div class="header">{{target.token.name}}</div>
      <div class="form-group">
        <label class="edges-banes">
          <select name="targets.{{@index}}.modifiers.edges" data-dtype="Number">
            {{selectOptions @root.modChoices selected=target.modifiers.edges}}
          </select>
          <span class="total-edges">{{localize "DRAW_STEEL.ROLL.Power.Prompt.Total" number=target.combinedModifiers.edges}}</span>
        </label>
        <label class="edges-banes">
          <select name="targets.{{@index}}.modifiers.banes" data-dtype="Number">
            {{selectOptions @root.modChoices selected=target.modifiers.banes}}
          </select>
          <span class="total-banes">{{localize "DRAW_STEEL.ROLL.Power.Prompt.Total" number=target.combinedModifiers.banes}}</span>
        </label>
        <label>
          {{numberInput target.modifiers.bonuses name=(concat "targets." @index ".modifiers.bonuses") step=1}}
          <span class="total-bonuses">{{localize "DRAW_STEEL.ROLL.Power.Prompt.Total" number=target.combinedModifiers.bonuses}}</span>
        </label>
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}
  <div class="ability-config">
    {{#if resource.show}}
    <fieldset>
      <legend>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.ResourceLegend" value=resource.current name=resource.name}}</legend>
      {{#if ability.system.resource}}
      <div class="form-group">
        <label>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.label"}}</label>
        <div class="form-fields">
          <input type="number" name="resource" value="{{resource.value}}">
        </div>
        <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.hint" value=ability.system.resource name=resource.name}}</p>
      </div>
      {{/if}}
      {{#if spendConfig}}
      <div class="form-group">
        <label>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Spend.label" value=spendConfig.value name=resource.name}}</label>
        <div class="form-fields">
          {{#if spendConfig.slider}}
          <range-picker name="spend" max="{{spendConfig.max}}" min="0" step="1"></range-picker>
          {{else}}
          <input type="checkbox" name="spend">
          {{/if}}
        </div>
        <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Spend.hint"}}</p>
      </div>
      {{/if}}

    </fieldset>
    {{/if}}
    {{#if damageOptions}}
    <div class="form-group">
      <label for="damage-selection">{{localize "DRAW_STEEL.ROLL.Power.Prompt.DamageSelectionLabel"}}</label>
      <div class="form-fields">
        <select name="damage-selection" id="damage-selection">
          {{selectOptions damageOptions selected=damage}}
        </select>
      </div>
    </div>
    {{/if}}
    {{!-- Ensures the buttons only render on the right side, fully replaced by the footer template --}}
    <section data-application-part="footer"></section>
  </div>
</section>
