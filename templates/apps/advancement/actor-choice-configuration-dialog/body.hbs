<section>
  {{#if enrichedDescription}}
  {{{enrichedDescription}}}
  {{/if}}
  <fieldset class="actor-choices">
    <legend>{{chooseLabel}}</legend>
    {{#each actors}}
    <div class="form-group">
      <label>{{{link}}}</label>
      <div class="form-fields">
        <input type="checkbox" value="{{uuid}}" name="choices" {{checked chosen}} {{disabled disabled}}>
      </div>
    </div>
    {{/each}}
  </fieldset>
</section>
