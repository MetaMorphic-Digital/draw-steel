<section class="standard-form">
  <div class="global group">
    <div class="header">{{formula}}</div>
    <div class="form-group general">
      <label class="edges-banes">
        <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Edges"}}</span>
        <select name="modifiers.edges" data-dtype="Number">
          {{selectOptions modChoices selected=modifiers.edges}}
        </select>
      </label>
      <label class="edges-banes">
        <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Banes"}}</span>
        <select name="modifiers.banes" data-dtype="Number">
          {{selectOptions modChoices selected=modifiers.banes}}
        </select>
      </label>
      <label>
        <span>{{localize "DRAW_STEEL.ROLL.Power.Modifier.Bonuses"}}</span>
        {{numberInput modifiers.bonuses name="modifiers.bonuses" step=1}}
      </label>
    </div>
  </div>
  {{#if skillOptions}}
  <div class="form-group">
    <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.skills.value.label"}}</label>
    <div class="form-fields">
      <select name="skill">
        {{selectOptions skillOptions blank=(localize "COMMON.None") selected=skill}}
      </select>
    </div>
  </div>
  {{/if}}
</section>
