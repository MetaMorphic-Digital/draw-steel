
<section class="ability-config">
  {{#if meleeRanged.show}}
  <div class="form-group meleeRanged">
    <span class="label">{{localize "DRAW_STEEL.Item.ability.Distance.MeleeRanged"}}</span>
    <button type="button" class="{{meleeRanged.meleeClass}}" data-action="swapMeleeRanged" data-value="melee" data-tooltip="DRAW_STEEL.Item.ability.SwapUsage.ToMelee"></button>
    <button type="button" class="{{meleeRanged.rangedClass}}" data-action="swapMeleeRanged" data-value="ranged" data-tooltip="DRAW_STEEL.Item.ability.SwapUsage.ToRanged"></button>
  </div>
  {{/if}}
  {{#if resource.show}}
  <fieldset>
    <legend>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.ResourceLegend" value=resource.current name=resource.name}}</legend>
    {{#if ability.system.resource}}
    <div class="form-group">
      <label for="{{rootId}}-resource">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.label"}}</label>
      <div class="form-fields">
        <input type="number" name="resource" value="{{resource.value}}" id="{{rootId}}-resource">
      </div>
      <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.hint" value=ability.system.resource name=resource.name}}</p>
    </div>
    {{/if}}
    {{#each spendConfig}}
    <div class="form-group">
      <label>{{localize (concat "DRAW_STEEL.SPECIAL_EFFECT.spend." (ifThen multiple "multiple" "single")) value=value resourceName=@root.resource.name}}</label>
      <div class="form-fields">
        {{#if multiple}}
        <range-picker name="{{concat "spend." id}}" max="{{@root.resource.max}}" min="0" step="{{value}}" value="{{lookup @root.spend id}}"></range-picker>
        {{else}}
        <input type="checkbox" name="{{concat "spend." id}}" {{checked (lookup @root.spend id)}} data-dtype="Number" value="{{value}}">
        {{/if}}
      </div>
      <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Spend.hint"}}</p>
    </div>
    {{/each}}
  </fieldset>
  {{/if}}
  {{#if damageOptions}}
  <div class="form-group">
    <label for="damage-selection">{{localize "DRAW_STEEL.ROLL.Power.Prompt.DamageSelectionLabel"}}</label>
    <div class="form-fields">
      <select name="damage-selection" id="{{rootId}}-damage-selection">
        {{selectOptions damageOptions selected=damage}}
      </select>
    </div>
  </div>
  {{/if}}
</section>
