<section class="tab {{tabs.ability.cssClass}}" data-group="primary" data-tab="ability">
  <fieldset>
    <legend>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.ResourceLegend" value=resource.current name=resource.name}}</legend>
    {{#if ability.system.resource}}
    <div class="form-group">
      <label>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.label"}}</label>
      <div class="form-fields">
        <input type="number" name="resource" value="{{resource.value}}">
      </div>
      <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Resource.hint" value=ability.system.resource name=resource.name}}</p>
    </div>
    {{/if}}
    {{#if spendConfig}}
    <div class="form-group">
      <label>{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Spend.label" value=spendConfig.value name=resource.name}}</label>
      <div class="form-fields">
        {{#if spendConfig.slider}}
        <range-picker name="spend" max="{{spendConfig.max}}" min="0" step="1"></range-picker>
        {{else}}
        <input type="checkbox" name="spend">
        {{/if}}
      </div>
      <p class="hint">{{localize "DRAW_STEEL.Item.ability.ConfigureUse.Spend.hint"}}</p>
    </div>
    {{/if}}

  </fieldset>
  {{#if damageOptions}}
  <div class="form-group">
    <label for="damage-selection">{{localize "DRAW_STEEL.ROLL.Power.Prompt.DamageSelectionLabel"}}</label>
    <div class="form-fields">
      <select name="damage-selection" id="damage-selection">
        {{selectOptions damageOptions selected=damage}}
      </select>
    </div>
  </div>
  {{/if}}
</section>
