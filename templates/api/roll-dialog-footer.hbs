<footer class="form-footer">
  <button type="submit">
    <i class="fa-solid fa-dice-d10"></i> {{buttonLabel}}
  </button>
  <div class="roll-mode-buttons split-button">
    {{#each messageModes as |mode|}}
    <button
      type="button"
      class="{{ifThen (eq @root.messageMode @key) "selected" ""}} ui-control icon {{mode.icon}}"
      data-action="setMessageMode"
      data-message-mode="{{@key}}"
      data-tooltip="{{mode.label}}">
    </button>
    {{/each}}
  </div>
</footer>
